<%
  const t = site.theme;
  // Routes call setMeta() (src/public.js) and leave the result on res.locals.meta. A view that
  // skipped it (e.g. the 500-error page, which renders ad hoc) still gets a sane fallback here.
  const meta = (typeof locals !== 'undefined' && locals.meta) ? locals.meta : seo.pageMeta(site, { path, page: typeof page !== 'undefined' ? page : '', title: typeof title !== 'undefined' ? title : '', description: typeof description !== 'undefined' ? description : '' });
  const fontsHref = h.fontsHref(t);
  const radius = t.buttonStyle === 'pill' ? '9999px' : (t.buttonStyle === 'none' ? '0px' : '0.5rem');
%><!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- seo.renderHead(meta) %>
  <% if (fontsHref) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="<%= fontsHref %>">
  <% } %>
  <script src="/vendor/tailwind-3.4.17.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { DEFAULT: 'rgb(var(--brand) / <alpha-value>)', dark: 'rgb(var(--brand-dark) / <alpha-value>)', light: 'rgb(var(--brand-light) / <alpha-value>)' },
            accent: { DEFAULT: 'rgb(var(--accent) / <alpha-value>)', dark: 'rgb(var(--accent-dark) / <alpha-value>)' },
            sand: '#f6f2ec',
          },
          fontFamily: {
            heading: [<%- JSON.stringify(t.headingFont || 'Playfair Display') %>, 'Georgia', 'serif'],
            body: [<%- JSON.stringify(t.bodyFont || 'Inter') %>, 'system-ui', 'sans-serif'],
          },
          maxWidth: { page: '80rem' },
        },
      },
    };
  </script>
  <style>
    :root {
      --brand: <%= h.rgbTriplet(t.primary, '31 58 95') %>;
      --brand-dark: <%= h.rgbTriplet(h.shade(t.primary, -0.25), '20 38 62') %>;
      --brand-light: <%= h.rgbTriplet(h.shade(t.primary, 0.9), '235 240 246') %>;
      --accent: <%= h.rgbTriplet(t.accent, '200 137 58') %>;
      --accent-dark: <%= h.rgbTriplet(h.shade(t.accent, -0.2), '160 110 46') %>;
      --btn-radius: <%= radius %>;
      --hero-overlay: <%= Math.max(0, Math.min(95, Number(t.heroOverlay) || 0)) / 100 %>;
    }
  </style>
  <link rel="stylesheet" href="/css/site.css?v=1">
  <% if (t.customCss) { %><style id="custom-css"><%- t.customCss %></style><% } %>
  <%- seo.renderJsonLd(site, { path, page: typeof page !== 'undefined' ? page : '', title: typeof title !== 'undefined' ? title : '', room: typeof room !== 'undefined' ? room : undefined, base: meta.base }) %>
  <%- seo.renderAnalyticsHead(site) %>
</head>
<body class="font-body text-gray-800 bg-white antialiased">
  <%- seo.renderBodyStart(site) %>
