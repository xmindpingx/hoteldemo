<%
  // usage: include('partials/section-heading', { eyebrow, heading, intro, align: 'left'|'center', link: {href,label} })
  const _align = (typeof align !== 'undefined' && align) || 'left';
  const _link = typeof link !== 'undefined' ? link : null;
  const _eyebrow = typeof eyebrow !== 'undefined' ? eyebrow : '';
  const _intro = typeof intro !== 'undefined' ? intro : '';
%>
<div class="flex flex-col <%= _align === 'center' ? 'items-center text-center' : 'md:flex-row md:items-end md:justify-between' %> gap-4 mb-10">
  <div class="max-w-2xl">
    <% if (_eyebrow) { %><div class="eyebrow"><%= _eyebrow %></div><% } %>
    <h2 class="font-heading text-3xl lg:text-4xl text-gray-900 leading-tight"><%= heading %></h2>
    <% if (_intro) { %><p class="mt-3 text-gray-600 leading-relaxed"><%= _intro %></p><% } %>
  </div>
  <% if (_link && _link.href) { %><a href="<%= _link.href %>" class="inline-flex items-center gap-2 text-brand font-semibold hover:text-accent shrink-0"><%= _link.label %><%- icon('arrow-right', 'w-4 h-4') %></a><% } %>
</div>
