<%
  const ar = site.area;
  const _compact = typeof compact !== 'undefined' && compact;
  const attractions = h.enabledItems(ar.attractions).filter((x) => x && x.name);
  const airports = (ar.airports || []).filter((x) => x && x.name);
  const transport = (ar.transport || []).filter((x) => x && x.name);
  const mapUrl = h.mapEmbedUrl(ar, site.general);
  const dirUrl = h.directionsUrl(ar, site.general);
  const cats = [...new Set(attractions.map((a) => a.category).filter(Boolean))];
  if (ar.enabled !== false && (attractions.length || ar.heading)) {
%>
<section class="max-w-page mx-auto px-4 py-16 lg:py-24" id="area">
  <%- include('section-heading', { eyebrow: 'Local Area', heading: ar.heading || 'Explore the Area', intro: ar.intro, link: _compact ? { href: '/area', label: 'Map, airports & more' } : null }) %>

  <% if (!_compact && cats.length > 1) { %>
  <div class="flex flex-wrap gap-2 mb-8" data-filter-group="attractions">
    <button type="button" class="chip is-active" data-filter="*">All</button>
    <% cats.forEach((c) => { %><button type="button" class="chip" data-filter="<%= c %>"><%= c %></button><% }) %>
  </div>
  <% } %>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-<%= _compact ? '3' : '4' %>" data-filter-items="attractions">
    <% (_compact ? attractions.slice(0, 6) : attractions).forEach((a) => { %>
      <article class="group rounded-2xl overflow-hidden ring-1 ring-black/5 bg-white shadow-sm flex flex-col" data-category="<%= a.category || '' %>">
        <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
          <% if (a.image) { %><img src="<%= a.image %>" alt="<%= a.name %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy"><% } %>
          <% if (a.category) { %><span class="absolute top-3 left-3 text-[11px] font-semibold uppercase tracking-wider bg-white/95 text-gray-800 px-2.5 py-1 rounded-full"><%= a.category %></span><% } %>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <h3 class="font-semibold text-gray-900 leading-snug"><% if (a.url) { %><a href="<%= a.url %>" target="_blank" rel="noopener" class="hover:text-brand"><%= a.name %></a><% } else { %><%= a.name %><% } %></h3>
          <% if (a.description) { %><p class="mt-1.5 text-sm text-gray-600 leading-relaxed flex-1"><%= a.description %></p><% } %>
          <% if (a.distance) { %><div class="mt-3 inline-flex items-center gap-1.5 text-xs text-gray-500"><%- icon('navigation', 'w-3.5 h-3.5 text-accent') %><%= a.distance %></div><% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <% if (!_compact) { %>
  <div class="mt-14 grid gap-8 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <% if (ar.showMap !== false && mapUrl) { %>
      <div class="rounded-2xl overflow-hidden ring-1 ring-black/5 shadow-sm bg-gray-100">
        <iframe src="<%= mapUrl %>" width="100%" height="420" style="border:0" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>
      </div>
      <% } %>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
        <% if (h.fullAddress(site.general.address)) { %><span class="inline-flex items-center gap-2 text-gray-700"><%- icon('map-pin', 'w-4 h-4 text-accent') %><%= h.fullAddress(site.general.address) %></span><% } %>
        <% if (dirUrl) { %><a href="<%= dirUrl %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-brand hover:text-accent"><%- icon('navigation', 'w-4 h-4') %>Get directions</a><% } %>
      </div>
    </div>
    <div class="lg:col-span-2 space-y-8">
      <% if (airports.length) { %>
      <div>
        <h3 class="font-heading text-2xl text-gray-900 mb-4">Airports</h3>
        <ul class="space-y-3">
          <% airports.forEach((ap) => { %>
            <li class="flex gap-3 rounded-xl bg-sand p-4">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white text-brand shrink-0"><%- icon('plane', 'w-5 h-5') %></span>
              <div>
                <div class="font-semibold text-gray-900"><%= ap.name %><% if (ap.code) { %> <span class="text-gray-400 font-normal">(<%= ap.code %>)</span><% } %></div>
                <% if (ap.distance) { %><div class="text-sm text-gray-600"><%= ap.distance %></div><% } %>
                <% if (ap.note) { %><div class="text-sm text-gray-500"><%= ap.note %></div><% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
      <% if (transport.length) { %>
      <div>
        <h3 class="font-heading text-2xl text-gray-900 mb-4">Getting Around</h3>
        <ul class="space-y-3">
          <% transport.forEach((t) => { %>
            <li class="flex gap-3">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-brand-light text-brand shrink-0"><%- icon('train', 'w-4 h-4') %></span>
              <div><div class="font-semibold text-gray-900"><%= t.name %></div><% if (t.note) { %><div class="text-sm text-gray-600"><%= t.note %></div><% } %></div>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>
</section>
<% } %>
