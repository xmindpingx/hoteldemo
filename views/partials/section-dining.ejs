<%
  const d = site.dining;
  const _compact = typeof compact !== 'undefined' && compact;
  const items = h.enabledItems(d.items).filter((x) => x && x.name);
  const nearby = (d.nearby || []).filter((x) => x && x.name);
  if (d.enabled !== false && (items.length || nearby.length || d.heading)) {
%>
<section class="bg-brand-dark text-white py-16 lg:py-24" id="dining">
  <div class="max-w-page mx-auto px-4">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
      <div class="max-w-2xl">
        <div class="eyebrow text-accent">Dining</div>
        <h2 class="font-heading text-3xl lg:text-4xl leading-tight"><%= d.heading || 'Dining' %></h2>
        <% if (d.intro) { %><p class="mt-3 text-white/75 leading-relaxed"><%= d.intro %></p><% } %>
      </div>
      <% if (_compact) { %><a href="/dining" class="inline-flex items-center gap-2 text-accent font-semibold hover:text-white shrink-0">Dining details<%- icon('arrow-right', 'w-4 h-4') %></a><% } %>
    </div>

    <% if (items.length) { const shown = _compact ? items.slice(0, 3) : items; %>
    <div class="grid gap-6 <%= shown.length === 1 ? '' : 'md:grid-cols-2' %> <%= shown.length >= 3 ? 'lg:grid-cols-3' : '' %>">
      <% shown.forEach((it) => { const single = shown.length === 1; %>
        <div class="rounded-2xl overflow-hidden bg-white/5 ring-1 ring-white/10 <%= single ? 'md:grid md:grid-cols-2' : '' %>">
          <% if (it.image) { %><img src="<%= it.image %>" alt="<%= it.name %>" class="w-full <%= single ? 'h-full min-h-[260px]' : 'aspect-[16/10]' %> object-cover" loading="lazy"><% } %>
          <div class="p-5 <%= single ? 'md:p-8 flex flex-col justify-center' : '' %>">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-heading text-xl"><%= it.name %></h3>
              <% if (it.badge) { %><span class="text-[11px] font-semibold uppercase tracking-wider bg-accent text-white px-2.5 py-1 rounded-full shrink-0"><%= it.badge %></span><% } %>
            </div>
            <% if (it.hours) { %><div class="mt-2 inline-flex items-center gap-2 text-sm text-white/70"><%- icon('clock', 'w-4 h-4 text-accent') %><%= it.hours %></div><% } %>
            <% if (it.description) { %><p class="mt-3 text-sm text-white/80 leading-relaxed"><%= it.description %></p><% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>

    <% if (!_compact && nearby.length) { %>
    <div class="mt-14">
      <h3 class="font-heading text-2xl mb-6">Nearby Dining</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% nearby.forEach((n) => { %>
          <div class="rounded-xl bg-white/5 ring-1 ring-white/10 p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="font-semibold"><% if (n.url) { %><a href="<%= n.url %>" target="_blank" rel="noopener" class="hover:text-accent"><%= n.name %></a><% } else { %><%= n.name %><% } %></div>
                <% if (n.cuisine) { %><div class="text-sm text-white/60"><%= n.cuisine %></div><% } %>
              </div>
              <% if (n.distance) { %><span class="text-xs text-white/70 whitespace-nowrap"><%= n.distance %></span><% } %>
            </div>
            <% if (n.note) { %><p class="mt-2 text-sm text-white/75"><%= n.note %></p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>
