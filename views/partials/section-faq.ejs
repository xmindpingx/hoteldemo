<%
  const faq = site.faq;
  const items = (faq.items || []).filter((x) => x && x.q);
  if (faq.enabled !== false && items.length) {
%>
<section class="bg-sand py-16 lg:py-24" id="faq">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="eyebrow justify-center">FAQ</div>
      <h2 class="font-heading text-3xl lg:text-4xl text-gray-900"><%= faq.heading || 'Good to Know' %></h2>
    </div>
    <div class="divide-y divide-gray-200 rounded-2xl bg-white ring-1 ring-black/5 shadow-sm">
      <% items.forEach((it, i) => { %>
        <details class="group p-5 lg:p-6" <%= i === 0 ? 'open' : '' %>>
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-gray-900">
            <span><%= it.q %></span>
            <%- icon('chevron-down', 'w-5 h-5 text-brand transition-transform group-open:rotate-180 shrink-0') %>
          </summary>
          <div class="mt-3 text-sm text-gray-600 leading-relaxed"><%- h.nl2br(it.a) %></div>
        </details>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
