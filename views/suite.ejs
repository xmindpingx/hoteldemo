<%- include('partials/head', { description: room.shortDescription || room.description }) %>
<%- include('partials/header') %>
<%
  const g = site.general;
  const images = [room.image, ...(room.images || [])].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i);
  const price = h.money(room.priceFrom, g.currency);
  const book = room.bookHref || (g.bookingMode === 'external' && g.bookingUrl ? g.bookingUrl : `/contact?room=${encodeURIComponent(room.name)}`);
  const specs = [
    room.sqft ? { icon: 'ruler', label: 'Size', text: `${room.sqft} sq ft` } : null,
    room.beds ? { icon: 'bed', label: 'Beds', text: room.beds } : null,
    room.sleeps ? { icon: 'users', label: 'Sleeps', text: String(room.sleeps) } : null,
    room.bathrooms ? { icon: 'bath', label: 'Bathrooms', text: String(room.bathrooms) } : null,
    room.view ? { icon: 'sun', label: 'View', text: room.view } : null,
  ].filter(Boolean);
  const others = h.enabledItems(site.rooms.items).filter((r) => r.slug !== room.slug).slice(0, 3);
%>
<section class="max-w-page mx-auto px-4 pt-8">
  <nav class="text-sm text-gray-500 flex items-center gap-2" aria-label="Breadcrumb">
    <a href="/" class="hover:text-brand">Home</a><%- icon('chevron-right', 'w-3.5 h-3.5') %>
    <a href="/suites" class="hover:text-brand"><%= site.rooms.heading || 'Suites' %></a><%- icon('chevron-right', 'w-3.5 h-3.5') %>
    <span class="text-gray-800"><%= room.name %></span>
  </nav>
</section>

<section class="max-w-page mx-auto px-4 py-8 grid gap-10 lg:grid-cols-12">
  <div class="lg:col-span-7">
    <% if (images.length) { %>
    <div data-lightbox-group>
      <a href="<%= images[0] %>" data-lightbox data-caption="<%= room.name %>" class="block rounded-2xl overflow-hidden bg-gray-100 aspect-[4/3]"><img src="<%= images[0] %>" alt="<%= room.name %>" class="w-full h-full object-cover" fetchpriority="high"></a>
      <% if (images.length > 1) { %>
      <div class="mt-3 grid grid-cols-4 gap-3">
        <% images.slice(1, 9).forEach((img) => { %><a href="<%= img %>" data-lightbox data-caption="<%= room.name %>" class="block rounded-xl overflow-hidden bg-gray-100 aspect-[4/3]"><img src="<%= img %>" alt="" class="w-full h-full object-cover hover:opacity-90 transition" loading="lazy"></a><% }) %>
      </div>
      <% } %>
    </div>
    <% } %>

    <div class="mt-8">
      <% if (room.type) { %><div class="eyebrow"><%= room.type %></div><% } %>
      <h1 class="font-heading text-3xl lg:text-4xl text-gray-900"><%= room.name %></h1>
      <% if (specs.length) { %>
      <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
        <% specs.forEach((s) => { %><div class="flex items-center gap-2"><%- icon(s.icon, 'w-5 h-5 text-brand') %><div><dt class="text-xs uppercase tracking-wider text-gray-500"><%= s.label %></dt><dd class="font-medium text-gray-900"><%= s.text %></dd></div></div><% }) %>
      </dl>
      <% } %>
      <div class="mt-6 text-gray-600 leading-relaxed text-[17px] space-y-4"><%- h.paragraphs(room.description || room.shortDescription) %></div>
      <% if ((room.features || []).length) { %>
      <h2 class="font-heading text-2xl text-gray-900 mt-10 mb-4">Suite features</h2>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2.5 text-sm text-gray-700">
        <% room.features.filter(Boolean).forEach((f) => { %><li class="flex items-start gap-2"><%- icon('check', 'w-4 h-4 mt-0.5 text-accent shrink-0') %><span><%= f %></span></li><% }) %>
      </ul>
      <% } %>
    </div>
  </div>

  <aside class="lg:col-span-5">
    <div class="lg:sticky lg:top-28 rounded-2xl ring-1 ring-black/5 shadow-lg p-6 bg-white">
      <% if (price) { %><div class="text-sm text-gray-500">From</div><div class="font-heading text-4xl text-gray-900"><%= price %></div><% } else { %><div class="font-heading text-2xl text-gray-900">Rates on request</div><% } %>
      <% if (room.priceNote) { %><div class="text-sm text-gray-500 mt-1"><%= room.priceNote %></div><% } %>
      <% if (g.bookingMode !== 'external' && !room.bookHref) { %>
      <form action="/contact" method="get" class="mt-5 grid grid-cols-2 gap-3">
        <input type="hidden" name="room" value="<%= room.name %>">
        <label class="text-xs font-semibold uppercase tracking-wider text-gray-500">Check-in<input type="date" name="checkin" class="field mt-1" data-checkin></label>
        <label class="text-xs font-semibold uppercase tracking-wider text-gray-500">Check-out<input type="date" name="checkout" class="field mt-1" data-checkout></label>
        <label class="text-xs font-semibold uppercase tracking-wider text-gray-500">Guests<select name="guests" class="field mt-1"><% for (let i = 1; i <= 8; i++) { %><option value="<%= i %>" <%= i === 2 ? 'selected' : '' %>><%= i %></option><% } %></select></label>
        <label class="text-xs font-semibold uppercase tracking-wider text-gray-500">Suites<select name="rooms" class="field mt-1"><% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>"><%= i %></option><% } %></select></label>
        <button type="submit" class="btn btn-primary col-span-2 py-3 mt-1"><%= g.bookNowLabel || 'Check Rates' %></button>
      </form>
      <% } else { %>
      <a href="<%= book %>" target="_blank" rel="noopener" class="btn btn-primary w-full py-3 mt-5"><%= g.bookNowLabel || 'Book Now' %><%- icon('external', 'w-4 h-4') %></a>
      <% } %>
      <% if (g.phone) { %><a href="<%= h.telHref(g.phone) %>" class="mt-3 btn btn-outline w-full py-3"><%- icon('phone', 'w-4 h-4') %>Call <%= g.phone %></a><% } %>
      <% if (g.checkInTime || g.checkOutTime) { %><p class="mt-4 text-xs text-gray-500 text-center"><% if (g.checkInTime) { %>Check-in <%= g.checkInTime %><% } %><% if (g.checkInTime && g.checkOutTime) { %> · <% } %><% if (g.checkOutTime) { %>Check-out <%= g.checkOutTime %><% } %></p><% } %>
    </div>
  </aside>
</section>

<% if (others.length) { %>
<section class="bg-sand py-16">
  <div class="max-w-page mx-auto px-4">
    <%- include('partials/section-heading', { eyebrow: 'More options', heading: 'Other suites', link: { href: '/suites', label: 'All suites' } }) %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% others.forEach((r) => { %><%- include('partials/room-card', { room: r }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
