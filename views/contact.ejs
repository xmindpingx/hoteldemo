<%- include('partials/head', { description: site.contact.intro }) %>
<%- include('partials/header') %>
<%
  const c = site.contact, g = site.general;
  const rooms = h.enabledItems(site.rooms.items);
  const mapUrl = h.mapEmbedUrl(site.area, g);
  const dirUrl = h.directionsUrl(site.area, g);
  const addr = h.fullAddress(g.address);
%>
<%- include('partials/page-hero', { eyebrow: 'Contact', heading: c.heading || 'Contact', intro: c.intro }) %>

<section class="max-w-page mx-auto px-4 py-16 grid gap-12 lg:grid-cols-12">
  <div class="lg:col-span-7">
    <% if (sent) { %>
      <div class="rounded-2xl bg-green-50 ring-1 ring-green-200 p-6 flex gap-4">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-green-600 text-white shrink-0"><%- icon('check', 'w-5 h-5') %></span>
        <div>
          <h2 class="font-heading text-2xl text-gray-900">Inquiry sent</h2>
          <p class="mt-2 text-gray-700"><%= c.successMessage || 'Thank you — we will be in touch shortly.' %></p>
          <a href="/" class="inline-flex items-center gap-2 mt-4 text-brand font-semibold hover:text-accent">Back to home<%- icon('arrow-right', 'w-4 h-4') %></a>
        </div>
      </div>
    <% } else if (c.formEnabled !== false) { %>
      <h2 class="font-heading text-2xl text-gray-900 mb-2">Booking inquiry</h2>
      <p class="text-sm text-gray-600 mb-6">Fields marked * are required.</p>
      <% if (error) { %><div class="mb-5 rounded-lg bg-red-50 text-red-700 ring-1 ring-red-200 px-4 py-3 text-sm"><%= error %></div><% } %>
      <form method="post" action="/contact" class="grid gap-4 sm:grid-cols-2">
        <div class="hidden" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <label class="block sm:col-span-1"><span class="label">Name *</span><input type="text" name="name" required class="field" value="<%= prefill.name || '' %>" autocomplete="name"></label>
        <label class="block sm:col-span-1"><span class="label">Email *</span><input type="email" name="email" required class="field" value="<%= prefill.email || '' %>" autocomplete="email"></label>
        <label class="block sm:col-span-1"><span class="label">Phone</span><input type="tel" name="phone" class="field" value="<%= prefill.phone || '' %>" autocomplete="tel"></label>
        <label class="block sm:col-span-1"><span class="label">Suite type</span>
          <select name="room" class="field">
            <option value="">No preference</option>
            <% rooms.forEach((r) => { %><option value="<%= r.name %>" <%= prefill.room === r.name ? 'selected' : '' %>><%= r.name %></option><% }) %>
          </select>
        </label>
        <label class="block"><span class="label">Check-in</span><input type="date" name="checkin" class="field" value="<%= prefill.checkin || '' %>"></label>
        <label class="block"><span class="label">Check-out</span><input type="date" name="checkout" class="field" value="<%= prefill.checkout || '' %>"></label>
        <label class="block"><span class="label">Guests</span><input type="number" name="guests" min="1" max="20" class="field" value="<%= prefill.guests || '' %>"></label>
        <label class="block"><span class="label">Suites</span><input type="number" name="rooms" min="1" max="20" class="field" value="<%= prefill.rooms || '' %>"></label>
        <label class="block sm:col-span-2"><span class="label">Message</span><textarea name="message" rows="5" class="field" placeholder="Tell us about your stay — length, special requests, questions…"><%= prefill.message || '' %></textarea></label>
        <div class="sm:col-span-2 flex items-center justify-between gap-4 flex-wrap">
          <p class="text-xs text-gray-500">We'll only use your details to reply to this inquiry.</p>
          <button type="submit" class="btn btn-primary px-6 py-3">Send inquiry<%- icon('arrow-right', 'w-4 h-4') %></button>
        </div>
      </form>
    <% } else { %>
      <p class="text-gray-600">Please call or email us to book — contact details are on the right.</p>
    <% } %>
  </div>

  <aside class="lg:col-span-5 space-y-6">
    <div class="rounded-2xl bg-sand p-6">
      <h2 class="font-heading text-2xl text-gray-900 mb-4"><%= h.fullName(g) %></h2>
      <ul class="space-y-4 text-sm text-gray-700">
        <% if (addr) { %><li class="flex gap-3"><%- icon('map-pin', 'w-5 h-5 text-accent shrink-0') %><div><div><%= addr %></div><% if (dirUrl) { %><a href="<%= dirUrl %>" target="_blank" rel="noopener" class="text-brand font-semibold hover:text-accent">Get directions</a><% } %></div></li><% } %>
        <% if (g.phone) { %><li class="flex gap-3"><%- icon('phone', 'w-5 h-5 text-accent shrink-0') %><a href="<%= h.telHref(g.phone) %>" class="hover:text-brand"><%= g.phone %></a></li><% } %>
        <% if (g.email) { %><li class="flex gap-3"><%- icon('mail', 'w-5 h-5 text-accent shrink-0') %><a href="mailto:<%= g.email %>" class="hover:text-brand break-all"><%= g.email %></a></li><% } %>
        <% if (c.hours) { %><li class="flex gap-3"><%- icon('clock', 'w-5 h-5 text-accent shrink-0') %><span><%= c.hours %></span></li><% } %>
        <% if (g.ratesNote) { %><li class="flex gap-3"><%- icon('tag', 'w-5 h-5 text-accent shrink-0') %><span><%= g.ratesNote %></span></li><% } %>
        <% if (g.checkInTime || g.checkOutTime) { %><li class="flex gap-3"><%- icon('key', 'w-5 h-5 text-accent shrink-0') %><span><% if (g.checkInTime) { %>Check-in <%= g.checkInTime %><% } %><% if (g.checkInTime && g.checkOutTime) { %> · <% } %><% if (g.checkOutTime) { %>Check-out <%= g.checkOutTime %><% } %></span></li><% } %>
      </ul>
    </div>
    <% if (c.showMap !== false && mapUrl) { %>
    <div class="rounded-2xl overflow-hidden ring-1 ring-black/5 shadow-sm bg-gray-100">
      <iframe src="<%= mapUrl %>" width="100%" height="320" style="border:0" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>
    </div>
    <% } %>
  </aside>
</section>
<%- include('partials/footer') %>
