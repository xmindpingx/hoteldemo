# Copy to .env (or set in ecosystem.config.cjs) — every value is optional.

# Port the Node server listens on (Cloudflare tunnel / nginx proxies to this)
PORT=8097

# Admin passphrase. Default is "hoteldemo". If set here it overrides any
# passphrase changed from inside the admin panel.
# ADMIN_PASSPHRASE=hoteldemo

# Secret used to sign admin session cookies. If unset, a random one is
# generated once and stored in data/.secret
# SESSION_SECRET=change-me

# Where site.json / inquiries.json / admin.json live (default: ./data)
# DATA_DIR=/home/dad/wwwhotel/hoteldemosite/data

# Public URL of the site (used for canonical/OG tags)
SITE_URL=https://hoteldemo1.signaturediversified.com
