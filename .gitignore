# dependencies
node_modules/

# live content & secrets (regenerated from data/defaults.json on first run)
data/site.json
data/site.json.tmp
data/inquiries.json
data/inquiries.json.tmp
data/admin.json
data/.secret
data/backups/

# uploaded media (keep the folder, not the files)
public/uploads/*
!public/uploads/.gitkeep

# env & logs
.env
*.log
logs/

# editor / OS
.DS_Store
.vscode/
.idea/

# aider state (config files .aider.conf.yml / .aider.model.* / .aiderignore ARE committed)
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/
.aider.llm.history
.aider*
# aider adds .aider* itself; keep the four CONFIG files tracked anyway
!.aider.conf.yml
!.aider.model.settings.yml
!.aider.model.metadata.json
!.aiderignore
